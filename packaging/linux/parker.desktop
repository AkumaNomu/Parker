[Desktop Entry]
Type=Application
Name=Parker
Comment=Region OCR, screenshot, and recording
Exec=parker
Terminal=false
Categories=Utility;AudioVideo;
Actions=Capture;Screenshot;Open;Record;

[Desktop Action Capture]
Name=Smart capture
Exec=parker capture

[Desktop Action Screenshot]
Name=Screenshot
Exec=parker shot

[Desktop Action Open]
Name=Open recordings
Exec=parker open

[Desktop Action Record]
Name=Start or stop recording
Exec=parker toggle
