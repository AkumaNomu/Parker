# Copy to %LOCALAPPDATA%\Parker\settings.env and restart Parker.
# Lines use KEY=VALUE. Process-level environment variables take precedence.

# --- OCR ---
# Supported languages: eng, ara, eng+ara, eng+fra, etc. (install the Tesseract language pack first)
PARKER_OCR_LANG=eng
PARKER_OCR_PSM=6
PARKER_OCR_MODE=auto
PARKER_QR_AUTO_OPEN=1
PARKER_KEEP_OCR_CAPTURE=0

# --- Recording ---
PARKER_RECORD_FPS=30
PARKER_COMPRESSION=balanced
PARKER_VIDEO_ENCODER=auto
PARKER_RING_SECONDS=45
# PARKER_MAX_WIDTH=1920
# PARKER_MAX_HEIGHT=1080
# PARKER_POST_CRF=24
# PARKER_POST_PRESET=medium

# --- Custom hotkeys (F1-F12, or single letter) ---
# PARKER_HOTKEY_OCR=F8
# PARKER_HOTKEY_RECORD=F9
# PARKER_HOTKEY_CLIP=F7
# PARKER_HOTKEY_SCROLL=F11
# PARKER_HOTKEY_FOLDER=F10
# PARKER_HOTKEY_QUIT=F12
# PARKER_HOTKEY_WEB=F6

# --- Paths (auto-detected if not set) ---
# PARKER_FFMPEG=C:\tools\ffmpeg.exe
# PARKER_TESSERACT=C:\Program Files\Tesseract-OCR\tesseract.exe
# PARKER_OUTPUT=%USERPROFILE%\Videos\Parker
