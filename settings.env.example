# Copy to the Parker settings file and restart Parker.
# Windows: %LOCALAPPDATA%\Parker\settings.env
# Linux:   ~/.config/parker/settings.env
PARKER_OCR_LANG_AUTO=1
PARKER_OCR_LANG=eng
PARKER_OCR_PSM=6
PARKER_OCR_MODE=auto
PARKER_QR_AUTO_OPEN=1
PARKER_KEEP_OCR_CAPTURE=0
# Translation (optional). Backend: none, argos, or libretranslate.
# PARKER_TRANSLATE_BACKEND=none
# PARKER_TRANSLATE_TARGET=en
# PARKER_TRANSLATE_OUTPUT=original
# PARKER_TRANSLATE_ENDPOINT=http://localhost:5000
PARKER_RECORD_FPS=30
PARKER_COMPRESSION=balanced
PARKER_VIDEO_ENCODER=auto
# Optional FFmpeg DirectShow audio device name (Windows) or PulseAudio source
# passed to wf-recorder --audio-device (Linux). Setting it enables audio capture;
# on Linux you can also just set PARKER_RECORD_AUDIO=1 for the default device.
# PARKER_AUDIO_DEVICE=Microphone Array (Realtek(R) Audio)
# PARKER_RECORD_AUDIO=0
# PARKER_MAX_WIDTH=1920
# PARKER_MAX_HEIGHT=1080
# PARKER_POST_CRF=24
# PARKER_POST_PRESET=medium
# PARKER_USE_GPU=1
# Explicit tool paths (optional; auto-detected otherwise).
# PARKER_FFMPEG=
# PARKER_TESSERACT=
# On GNOME Wayland, the bundled portal_capture.py helper uses the desktop
# screenshot portal for region selection (requires python3-gobject).
# Final video directory (default: Videos\Parker).
# PARKER_OUTPUT=
# Hotkey overrides are Windows-only; Parker always applies Ctrl+Shift.
# F8 capture, F9 screenshot, F10 recordings, F11 record, F12 exit.
# PARKER_HOTKEY_OCR=F8
# PARKER_HOTKEY_SHOT=F9
# PARKER_HOTKEY_FOLDER=F10
# PARKER_HOTKEY_RECORD=F11
# PARKER_HOTKEY_QUIT=F12
